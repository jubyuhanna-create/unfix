{
  "name": "unfix-ai",
  "version": "0.1.4",
  "description": "Un-fix bugs you already fixed, then see which AI coding agent fixes them again. A private benchmark built from your own git history.",
  "type": "module",
  "bin": {
    "unfix": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/unit.test.js dist/test/e2e.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "benchmark",
    "eval",
    "claude-code",
    "codex",
    "aider",
    "swe-bench",
    "git",
    "cli"
  ],
  "author": "El7ajb",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubyuhanna-create/unfix.git"
  },
  "homepage": "https://github.com/jubyuhanna-create/unfix#readme"
}
